# Local development only. Set explicit values before exposing the service.
PREDRIVE_ENV=development
PREDRIVE_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PREDRIVE_MAX_FRAME_BYTES=2097152
PREDRIVE_MAX_IMAGE_WIDTH=1920
PREDRIVE_MAX_IMAGE_HEIGHT=1080
PREDRIVE_MAX_FPS=5
PREDRIVE_MAX_CONNECTIONS=20
PREDRIVE_MAX_SESSIONS=100
PREDRIVE_MAX_FRAME_AGE_SECONDS=10
PREDRIVE_MAX_FUTURE_SKEW_SECONDS=5
PREDRIVE_SESSION_TTL_SECONDS=3600
